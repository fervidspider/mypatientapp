<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:mypatientapp.ViewModel"
             xmlns:model="clr-namespace:mypatientapp.Model"
             x:DataType="viewmodel:DashboardViewModel"
             x:Class="mypatientapp.View.Dashboard">


    <Grid ColumnDefinitions="*,3*" Margin="20" ColumnSpacing="15">

        <Frame Grid.Column="0" Grid.ColumnSpan="1" BackgroundColor="#28292E" BorderColor="Transparent" CornerRadius="25" Padding="0">

            <Grid RowDefinitions="40,*">

                        <Border Grid.Row="0" StrokeThickness="0"
                            StrokeShape="RoundRectangle 20,20,0,0"
                            Background="#005EB8"
                            >
                        
                        <Label Text="  Dashboard  "
                               TextColor="White"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               />
                    </Border>

            </Grid>


        </Frame>

        <Frame Grid.Column="1" BackgroundColor="#28292E" BorderColor="Transparent" CornerRadius="25" Padding="0">

            <Grid RowDefinitions="40,*">

            <Border Grid.Row="0" StrokeThickness="0"
                            StrokeShape="RoundRectangle 20,20,0,0"
                            Background="#005EB8"
                            >
                        
                        <Label Text="  Appointments Today  "
                               TextColor="White"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               />
                    </Border>

            <CollectionView Margin="15" Grid.Row="1" ItemsSource="{Binding Appointments}" >

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="15" HorizontalItemSpacing="15" Span="2"    />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="model:Appointment">

                    <Frame BackgroundColor="#222327" BorderColor="Transparent" CornerRadius="15" Padding="0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                        </Frame.GestureRecognizers>
                        <Grid RowDefinitions="auto" ColumnDefinitions="auto,auto,*" ColumnSpacing="5">
                            <Label Grid.Column="0" Text="{Binding title}"
                                   FontSize="Medium" Margin="15"/>
                            <Label Grid.Column="1" Text="{Binding datetime.TimeOfDay}"
                                   FontSize="Medium" Opacity="0.75" Margin="0,15,0,15"/>
                            <Frame Grid.Column="2" BackgroundColor="#28292E" BorderColor="Transparent" Margin="10" Padding="10,5,10,5" HorizontalOptions="End">
                                <Label Text="{Binding status}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                        </Grid>
                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        </Grid>



        </Frame>

    </Grid>

</ContentPage>

