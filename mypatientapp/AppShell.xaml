<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="mypatientapp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:mypatientapp"
    xmlns:view="clr-namespace:mypatientapp.View"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>

        <ShellContent
        Title="Dashboard"
        ContentTemplate="{DataTemplate view:Dashboard}"
        Route="Dashboard" />

        <ShellContent
        Title="Patients"
        ContentTemplate="{DataTemplate view:Patients}"
        Route="Patients" />

        <ShellContent
        Title="Appointments"
        ContentTemplate="{DataTemplate view:Appointments}"
        Route="Appointments" />

    </TabBar>

</Shell>

